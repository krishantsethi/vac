# VAXBRIDGE AI — frontend configuration.
#
# Copy to .env.local. There is exactly ONE variable, and leaving it unset is
# correct for both local development and production. No secret belongs in this
# app: the browser talks to same-origin /api/v1 paths and the server holds every
# credential.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the JavaScript bundle and shipped
# to every browser. Never put a service-role key, database URL or signing secret
# here.

# Absolute origin of the backend, used by the dev-server rewrite in
# next.config.mjs. Three cases:
#
#   unset + running locally  -> proxied to http://localhost:8000 (the default)
#   unset + running on Vercel-> NO rewrite. The Python function answers /api/v1/*
#                               on this same origin, which keeps the session
#                               cookie first-party.
#   set                      -> proxied to that origin. Use when the backend is
#                               hosted separately. Note this makes the session
#                               cookie third-party; see docs/DEPLOYMENT.md.
NEXT_PUBLIC_API_URL=

# Set to 1 to force same-origin behaviour (no rewrite) even outside Vercel.
# Vercel sets this on the project; it is only needed here for an unusual setup.
API_SAME_ORIGIN=

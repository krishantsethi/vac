# Copy to .env.local and adjust. Leaving this unset is correct for the default
# setup: the browser calls same-origin /api/v1 paths and next.config.mjs proxies
# them to the API, so no secret and no cross-origin URL is needed in the client.

# Absolute API origin used by the dev-server rewrite. Leave unset to use the
# bundled default of http://localhost:8000.
NEXT_PUBLIC_API_URL=

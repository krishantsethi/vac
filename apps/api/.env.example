# Copy to .env and set real values. Never commit a filled-in .env.
# Every value below has a working development fallback except the two secrets,
# which MUST be set explicitly in any deployment beyond local development.

# Any SQLAlchemy URL. SQLite is the default so the demo runs with no server.
DATABASE_URL=sqlite:///./vaxbridge_demo.db

# Signs JWTs. A development fallback exists; overriding it is mandatory in production.
VAULT_SECRET_KEY=

# Signs digital-record QR payloads (HMAC-SHA256). Falls back to VAULT_SECRET_KEY.
VAULT_RECORD_SECRET=

# How long a signed record link stays valid, in seconds (default 30 days).
RECORD_TTL_SECONDS=2592000

# Issuer string printed on generated records.
RECORD_ISSUER=VAXBRIDGE AI demonstration instance

# Document extraction. "true" runs the labeled demonstration fixtures.
# No live OCR provider is integrated; there is no key to supply for one.
OCR_DEMO_MODE=true

# Where uploaded documents are written.
UPLOAD_DIR=./uploads

# Requests per window.
RATE_LIMIT_DEFAULT=600
RATE_LIMIT_AUTH=20

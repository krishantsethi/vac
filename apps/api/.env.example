# VAXBRIDGE AI — backend configuration.
#
# Copy to .env for local development. Never commit a filled-in .env; .gitignore
# already excludes .env and .env.* except this file.
#
# The rule this file follows: ONLY the database is mandatory, and even that has a
# working default. Every optional integration degrades to an honest "unavailable"
# rather than blocking startup. Nothing here is a paid service, and no variable
# below has a hidden cost attached.

# --------------------------------------------------------------------------- #
# DATABASE — the only variable that determines whether data survives a restart
# --------------------------------------------------------------------------- #

# Local development: a SQLite file. Works with no server and no account.
#   sqlite:///./vaxbridge_demo.db
# Production: any PostgreSQL. Supabase's free tier is what this project uses.
#   postgresql+psycopg2://ROLE.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Use the transaction pooler (port 6543) from serverless. The direct port (5432)
# has a small connection budget and many concurrent function instances will
# exhaust it.
#
# A SQLite file is NOT a production database. On a serverless host the
# filesystem is scratch space, so rows written at runtime disappear on the next
# cold start. /api/v1/health reports database_persistent=false in that case.
DATABASE_URL=sqlite:///./vaxbridge_demo.db

# Connection pool. Defaults are sized for serverless: small, validated before
# use, and recycled before the server's own idle timeout closes the socket.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=vaxbridge-api

# --------------------------------------------------------------------------- #
# SECRETS — mandatory in any deployment beyond a laptop
# --------------------------------------------------------------------------- #

# Signs JWTs. A development fallback exists so the demo runs unconfigured; using
# it in production would let anyone forge a token for any role.
VAULT_SECRET_KEY=

# Signs digital-record QR payloads (HMAC-SHA256). Falls back to VAULT_SECRET_KEY.
# Set a distinct value so a leaked signing key cannot also forge records.
VAULT_RECORD_SECRET=

# How long a signed record link stays valid, in seconds (default 30 days).
RECORD_TTL_SECONDS=2592000

# Issuer string printed on generated records.
RECORD_ISSUER=VAXBRIDGE AI demonstration instance

# --------------------------------------------------------------------------- #
# SESSION COOKIE
# --------------------------------------------------------------------------- #
# These three exist because of how browsers treat an embedded app. When the site
# is opened inside an iframe on another registrable domain, its own session
# cookie is third-party: SameSite=Lax is dropped from every fetch, and where
# third-party cookies are blocked, SameSite=None alone is not stored either.
# Partitioned (CHIPS) is what makes the cookie exist in that context.
#
# Served top-level over HTTPS — the normal production case — these defaults are
# correct and need no change.

SESSION_COOKIE_NAME=vaxbridge_session
SESSION_COOKIE_MAX_AGE=2592000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_PARTITIONED=true
# "auto" reads X-Forwarded-Proto instead of a fixed value.
# SESSION_COOKIE_SECURE=auto

# --------------------------------------------------------------------------- #
# DOCUMENT STORAGE
# --------------------------------------------------------------------------- #

# local    — writes under UPLOAD_DIR. Default. Fine for development; NOT durable
#            on serverless, and the health endpoint says so.
# supabase — private bucket over the Supabase Storage REST API. Reads go through
#            short-lived signed URLs; objects are never public.
STORAGE_BACKEND=local

# Where the local backend writes. Must be writable; on a read-only serverless
# filesystem use /tmp.
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Required only when STORAGE_BACKEND=supabase.
SUPABASE_URL=
# The service-role key bypasses row-level security. Server-side only. It must
# never be prefixed NEXT_PUBLIC_ or shipped to a browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vaxbridge-documents

# --------------------------------------------------------------------------- #
# OCR — MODE A (core). No paid service, no API key, no account.
# --------------------------------------------------------------------------- #

# demo       — the deterministic labelled fixture. Reads nothing from the image
#              and always declares that it did not.
# tesseract  — real OCR via the open-source Tesseract binary, invoked as a
#              subprocess. Free and offline. Requires `tesseract` on PATH, and
#              `pdftoppm` (poppler-utils) to handle PDFs.
# none       — extraction disabled; documents are uploaded for manual entry.
# auto       — Tesseract when genuinely installed, otherwise the demo fixture.
#              DEFAULT. The choice is recorded on every document.
OCR_PROVIDER=auto

# Legacy switch, still honoured: "true" forces OCR_PROVIDER=demo.
OCR_DEMO_MODE=true

OCR_TIMEOUT_SECONDS=60
# Tesseract's own 0-100 scale. Below this a word is treated as unread rather
# than guessed, because a wrong vaccination date is worse than a missing one.
OCR_MIN_CONFIDENCE=60

# --------------------------------------------------------------------------- #
# AI — MODE B (enhanced). Entirely optional. Nothing requires it.
# --------------------------------------------------------------------------- #
# With AI_PROVIDER=none the deterministic insights at /api/v1/insights are fully
# available, and /api/v1/ai/ask returns the retrieved records plus an explicit
# statement that no model ran. Core functionality never depends on this section.
#
# No provider is hardcoded and no key is embedded anywhere in this repository.

# none | openai | anthropic | google | openai_compatible
AI_PROVIDER=none
AI_API_KEY=
# Leave blank to use the provider's default model.
AI_MODEL=
# Required for openai_compatible (e.g. a local Ollama or vLLM endpoint), which is
# how the enhanced mode can run with no paid service at all.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
# Ceiling on how much patient data may be placed in a prompt.
AI_MAX_CONTEXT_ROWS=50

# --------------------------------------------------------------------------- #
# RATE LIMITING
# --------------------------------------------------------------------------- #
# In-process and therefore PER INSTANCE. On a single server it is a real control;
# across serverless invocations it is best-effort only, because each instance has
# its own counters. A production deployment that needs a hard guarantee should
# put a shared store or an edge-level limit in front. This is recorded as a known
# limitation in docs/AUDIT.md rather than presented as solved.
RATE_LIMIT_DEFAULT=600
RATE_LIMIT_AUTH=60
RATE_LIMIT_WINDOW_SECONDS=60

# --------------------------------------------------------------------------- #
# PLATFORM
# --------------------------------------------------------------------------- #

# Set to 1 behind a proxy that supplies X-Forwarded-For / X-Forwarded-Proto
# (Vercel, nginx, ALB). Without it, rate limiting keys every request to the
# proxy's address and the cookie cannot detect the client's scheme.
TRUST_PROXY_HEADERS=1

# Comma-separated origins allowed by CORS. Not needed when the frontend and the
# API share an origin, which is the recommended production layout.
CORS_ALLOWED_ORIGINS=

# Logs [auth-diag] lines naming the stage of every authentication failure, with
# token length and a 12-hex SHA-256 prefix — never the token itself.
AUTH_DIAGNOSTICS=1

# Accepts client-side diagnostic reports at POST /api/v1/_diag/client.
# Scrubs password/token/authorization/cookie/hash before logging.
ENABLE_CLIENT_DIAGNOSTICS=1

# --------------------------------------------------------------------------- #
# STARTUP BEHAVIOUR
# --------------------------------------------------------------------------- #
# On SQLite the schema is created and the synthetic demo dataset is seeded on
# first run, which is what makes the demo work with no setup.
#
# On PostgreSQL neither happens automatically: migrations own the schema and the
# application's database role has no DDL privilege. Seeding a managed database is
# opt-in, because writing synthetic clinical rows into a real registry is not a
# decision a cold start should make.

# Seed the synthetic demonstration dataset into a managed database. Set to 1 for
# the first deployment of a demo instance, then REMOVE it.
SEED_DEMO_DATA=

# Force create_all against a managed database. Requires DDL privileges the
# application role deliberately does not have. Leave unset.
RUN_CREATE_ALL=
